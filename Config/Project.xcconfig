// Every target and configuration of the project, under project.yml's own settings. Your Apple Developer team
// comes from Signing.xcconfig at the root, which git ignores and XcodeGen never rewrites: make signing TEAM=…
// writes it (j23n/apple-ci README.md, "Signing"). Without it the project has no team, as in CI.

DEVELOPMENT_TEAM =

#include? "../Signing.xcconfig"
