# Images and screenshots go through Git LFS. Run `git lfs install` once per clone.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.heic filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
docs/design/screenshots/** filter=lfs diff=lfs merge=lfs -text

# The app icon is a small flat PNG the build needs even in a checkout without Git LFS.
Omnomnom/Assets.xcassets/**/*.png -filter -diff -merge
